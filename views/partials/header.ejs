<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · Tinta & Lomo</title><link rel="stylesheet" href="<%= basePath %>/css/style.css"></head><body>
<header class="topbar"><a class="brand" href="<%= basePath %>/">Tinta <span>&</span> Lomo</a><nav><% if(currentUser){ %><a href="<%= basePath %>/">Catálogo</a><% } %><% if(currentUser?.role==='admin'){ %><a href="<%= basePath %>/admin">Administrar</a><% } %><% if(currentUser){ %><span class="user"><%= currentUser.name %></span><form class="inline" method="post" action="<%= basePath %>/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link">Salir</button></form><% }else{ %><a href="<%= basePath %>/login">Ingresar</a><a class="pill" href="<%= basePath %>/register">Crear cuenta</a><% } %></nav></header>
<main class="shell"><% if(success){ %><div class="flash success"><%= success %></div><% } %><% if(error){ %><div class="flash error"><%= error %></div><% } %>
