<%- include('../partials/header') %><a class="back" href="<%= basePath %>/">← Volver al catálogo</a>
<section class="detail"><div class="gallery"><% if(book.images.length){book.images.forEach(i=>{ %><img src="<%= basePath %><%= i.file_path %>" alt="<%= i.alt_text || book.title %>"><% })}else{ %><div class="cover placeholder"><span><%= book.title.slice(0,1) %></span></div><% } %></div><div><p class="eyebrow"><%= book.category %> · <%= book.format %></p><h1><%= book.title %></h1><p class="byline">por <%= book.authors.map(a=>a.name).join(', ') || 'Autor por asignar' %></p><p class="lead"><%= book.description || 'Este título aún no tiene una descripción editorial.' %></p><dl><dt>ISBN</dt><dd><%= book.isbn %></dd><dt>Publicación</dt><dd><%= book.publication_year %></dd><dt>Géneros</dt><dd><%= book.genres.map(g=>g.name).join(', ') || 'Sin clasificar' %></dd><dt>Disponibilidad</dt><dd><%= book.stock %> ejemplares</dd></dl><p class="big-price">$<%= Number(book.price).toFixed(2) %></p></div></section>
<section class="concepts"><div class="section-title"><h2>Conceptos de la obra</h2></div><% book.concepts.forEach(c=>{ %><article><h3><%= c.term %></h3><p><%= c.definition %></p><small><%= [c.chapter_reference,c.page_reference&&'p. '+c.page_reference].filter(Boolean).join(' · ') %></small></article><% }) %><% if(!book.concepts.length){ %><p>Aún no hay conceptos documentados.</p><% } %></section>
<%- include('../partials/footer') %>
