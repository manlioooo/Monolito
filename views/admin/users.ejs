<%- include('../partials/header') %><div class="admin-head"><div><a class="back" href="<%= basePath %>/admin">← Panel</a><h1>Usuarios</h1></div></div><section class="panel"><h2>Nuevo usuario</h2><form class="row-form" method="post" action="<%= basePath %>/admin/users"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" placeholder="Nombre" required><input type="email" name="email" placeholder="Correo" required><input type="password" name="password" minlength="8" placeholder="Contraseña" required><select name="role"><option value="user">Usuario</option><option value="admin">Administrador</option></select><button>Crear</button></form></section><div class="table-wrap"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Activo</th><th></th></tr></thead><tbody><% users.forEach(u=>{ %><tr><form method="post" action="<%= basePath %>/admin/users/<%= u.id %>?_method=PUT"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><td><input name="name" value="<%= u.name %>" required></td><td><input type="email" name="email" value="<%= u.email %>" required></td><td><select name="role"><option value="user" <%= u.role==='user'?'selected':'' %>>Usuario</option><option value="admin" <%= u.role==='admin'?'selected':'' %>>Administrador</option></select></td><td><input type="checkbox" name="active" <%= u.active?'checked':'' %>></td><td class="actions"><button>Guardar</button></form><form method="post" action="<%= basePath %>/admin/users/<%= u.id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger link">Eliminar</button></form></td></tr><% }) %></tbody></table></div><%- include('../partials/footer') %>
