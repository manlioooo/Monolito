<%- include('../../partials/header') %><div class="admin-head"><div><a class="back" href="<%= basePath %>/admin">← Panel</a><h1>Libros</h1></div><a class="button" href="<%= basePath %>/admin/books/new">+ Nuevo libro</a></div><form class="search compact" action="<%= basePath %>/admin/books"><div><input name="q" value="<%= q %>" placeholder="Título o ISBN"><button>Buscar</button></div></form><div class="table-wrap"><table><thead><tr><th>ISBN</th><th>Título</th><th>Autores</th><th>Precio</th><th>Stock</th><th></th></tr></thead><tbody><% books.forEach(b=>{ %><tr><td><%= b.isbn %></td><td><strong><%= b.title %></strong></td><td><%= b.authors %></td><td>$<%= Number(b.price).toFixed(2) %></td><td><%= b.stock %></td><td class="actions"><a href="<%= basePath %>/admin/books/<%= b.id %>/edit">Editar</a><form method="post" action="<%= basePath %>/admin/books/<%= b.id %>?_method=DELETE" onsubmit="return confirm('¿Eliminar este libro y todas sus relaciones?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger link">Eliminar</button></form></td></tr><% }) %></tbody></table></div><%- include('../../partials/footer') %>
