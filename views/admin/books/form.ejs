<%- include('../../partials/header') %><div class="admin-head"><div><a class="back" href="<%= basePath %>/admin/books">← Libros</a><h1><%= book ? 'Editar libro' : 'Nuevo libro' %></h1></div></div>
<form class="panel form-grid" method="post" action="<%= basePath %><%= book ? '/admin/books/'+book.id+'?_method=PUT' : '/admin/books' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>ISBN<input name="isbn" required maxlength="17" value="<%= book?.isbn || '' %>"></label><label>Título<input name="title" required maxlength="250" value="<%= book?.title || '' %>"></label><label>Año<input type="number" name="publication_year" min="1450" max="2100" required value="<%= book?.publication_year || new Date().getFullYear() %>"></label><label>Precio<input type="number" name="price" min="0" step="0.01" required value="<%= book?.price || 0 %>"></label><label>Stock<input type="number" name="stock" min="0" required value="<%= book?.stock || 0 %>"></label><label>Formato<select name="format_id" required><% formats.forEach(x=>{ %><option value="<%= x.id %>" <%= book?.format_id===x.id?'selected':'' %>><%= x.name %></option><% }) %></select></label><label>Categoría<select name="category_id" required><% categories.forEach(x=>{ %><option value="<%= x.id %>" <%= book?.category_id===x.id?'selected':'' %>><%= x.name %></option><% }) %></select></label><label class="wide">Descripción<textarea name="description" rows="4"><%= book?.description || '' %></textarea></label><fieldset><legend>Autores</legend><div class="checks"><% authors.forEach(x=>{ %><label><input type="checkbox" name="author_ids" value="<%= x.id %>" <%= book?.authors.some(a=>a.id===x.id)?'checked':'' %>><%= x.name %></label><% }) %></div></fieldset><fieldset><legend>Géneros</legend><div class="checks"><% genres.forEach(x=>{ %><label><input type="checkbox" name="genre_ids" value="<%= x.id %>" <%= book?.genres.some(g=>g.id===x.id)?'checked':'' %>><%= x.name %></label><% }) %></div></fieldset><div class="wide"><button><%= book ? 'Guardar cambios' : 'Crear libro' %></button></div></form>
<% if(book){ %><section class="split"><div class="panel"><h2>Conceptos y definiciones</h2><form method="post" action="<%= basePath %>/admin/books/<%= book.id %>/concepts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Concepto<select name="concept_id"><% concepts.forEach(c=>{ %><option value="<%= c.id %>"><%= c.term %></option><% }) %></select></label><label>Definición en este libro<textarea name="definition" minlength="10" required></textarea></label><label>Capítulo o sección<input name="chapter_reference" maxlength="80"></label><label>Página o rango<input name="page_reference" maxlength="40"></label><button>Guardar definición</button></form><ul class="managed"><% book.concepts.forEach(c=>{ %><li><div><strong><%= c.term %></strong><p><%= c.definition %></p><small><%= [c.chapter_reference,c.page_reference&&'p. '+c.page_reference].filter(Boolean).join(' · ') %></small></div><form method="post" action="<%= basePath %>/admin/books/<%= book.id %>/concepts/<%= c.id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger link">Quitar</button></form></li><% }) %></ul></div><div class="panel"><h2>Imágenes</h2><form method="post" enctype="multipart/form-data" action="<%= basePath %>/admin/books/<%= book.id %>/images?_csrf=<%= csrfToken %>"><label>Archivo JPG, PNG o WebP<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><label>Texto alternativo<input name="alt_text" maxlength="250"></label><label>Orden<input type="number" name="sort_order" min="0" value="0"></label><label class="check-one"><input type="checkbox" name="is_primary"> Imagen principal</label><button>Cargar imagen</button></form><div class="image-admin"><% book.images.forEach(i=>{ %><figure><img src="<%= basePath %><%= i.file_path %>" alt="<%= i.alt_text %>"><figcaption><form method="post" action="<%= basePath %>/admin/books/<%= book.id %>/images/<%= i.id %>?_method=PUT"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="alt_text" maxlength="250" value="<%= i.alt_text %>" aria-label="Texto alternativo"><input type="number" name="sort_order" min="0" value="<%= i.sort_order %>" aria-label="Orden"><label class="check-one"><input type="checkbox" name="is_primary" <%= i.is_primary?'checked':'' %>> Portada</label><button>Guardar</button></form><form method="post" action="<%= basePath %>/admin/books/<%= book.id %>/images/<%= i.id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger link">Eliminar</button></form></figcaption></figure><% }) %></div></div></section><% } %><%- include('../../partials/footer') %>
