<%- include('../../partials/header') %><div class="admin-head"><div><a class="back" href="<%= basePath %>/admin">← Panel</a><h1><%= title.charAt(0).toUpperCase()+title.slice(1) %></h1></div><a class="button" href="<%= basePath %>/admin/masters/<%= resource %>/new">+ Nuevo registro</a></div><div class="table-wrap"><table><thead><tr><th>ID</th><% meta.labels.forEach(x=>{ %><th><%= x %></th><% }) %><th></th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= row.id %></td><% meta.fields.forEach(f=>{ %><td><%= row[f] %></td><% }) %><td class="actions"><a href="<%= basePath %>/admin/masters/<%= resource %>/<%= row.id %>/edit">Editar</a><form method="post" action="<%= basePath %>/admin/masters/<%= resource %>/<%= row.id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger link">Eliminar</button></form></td></tr><% }) %></tbody></table></div><%- include('../../partials/footer') %>
