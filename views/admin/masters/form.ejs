<%- include('../../partials/header') %><section class="auth-card wide-card"><a class="back" href="<%= basePath %>/admin/masters/<%= resource %>">← Volver</a><h1><%= title %></h1><form method="post" action="<%= basePath %><%= row ? '/admin/masters/'+resource+'/'+row.id+'?_method=PUT' : '/admin/masters/'+resource %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% meta.fields.forEach((f,i)=>{ %><label><%= meta.labels[i] %><% if(f==='description'||f==='biography'){ %><textarea name="<%= f %>" rows="5"><%= row?.[f] || '' %></textarea><% }else{ %><input name="<%= f %>" required maxlength="200" value="<%= row?.[f] || '' %>"><% } %></label><% }) %><button>Guardar</button></form></section><%- include('../../partials/footer') %>
