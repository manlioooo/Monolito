[Unit]
Description=Libreria monolitica Node.js
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=library
Group=library
WorkingDirectory=/opt/library
EnvironmentFile=/opt/library/.env
ExecStart=/usr/bin/node /opt/library/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/library/uploads

[Install]
WantedBy=multi-user.target
